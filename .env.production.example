# Production build — set these before `npm run build`.
# In Azure Static Web Apps CI, configure as pipeline secrets.

# Full URL of the Django API (Azure Container App).
VITE_API_BASE_URL=https://your-app.azurecontainerapps.io

# Same value as backend API_KEY.
VITE_API_KEY=replace-with-same-value-as-backend-API_KEY
